{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/api/donors",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "s-maxage=5, stale-while-revalidate=10"
        }
      ]
    }
  ]
}
